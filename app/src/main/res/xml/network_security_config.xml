<?xml version="1.0" encoding="utf-8"?>
<!--
    Documenta explícitamente los únicos dominios que la app debería tocar hoy (harvester
    aparte — esto es solo para :app). No es un firewall real (Android no ofrece uno a nivel
    de manifest): el código solo llama estas URLs fijas de cualquier forma. Lo que sí hace:
    bloquea HTTP sin cifrar (cleartext) por completo.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">collectionapi.metmuseum.org</domain>
        <domain includeSubdomains="false">images.metmuseum.org</domain>
        <domain includeSubdomains="false">api.artic.edu</domain>
        <domain includeSubdomains="false">www.artic.edu</domain>
        <!-- Sync de artworks nuevas (ArtworkSyncService, 2026-08-19) — api.github.com da
             el último release, el asset real se baja de un dominio de CDN firmado que
             GitHub puede cambiar sin aviso (visto: release-assets.githubusercontent.com,
             antes objects.githubusercontent.com), por eso ese no se lista acá. -->
        <domain includeSubdomains="false">api.github.com</domain>
        <domain includeSubdomains="false">github.com</domain>
    </domain-config>
</network-security-config>
